{
  "name": "rivbins",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Cycle Count Scoring \u2014 risk-based bin auditing for warehouses",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "pnpm --filter @rivbins/shared build && pnpm --parallel --filter @rivbins/api --filter @rivbins/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @rivbins/api db:migrate"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
