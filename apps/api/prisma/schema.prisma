// Smart Cycle Count Scoring — data model.
// Business rules behind this schema are documented in CLAUDE.md and DECISIONS.md.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum MovementType {
  PUTAWAY
  PICK
  MOVE
  ADJUSTMENT
}

enum TaskStatus {
  PENDING
  DONE
}

enum AuditOutcome {
  PASS
  FAIL
}

enum ScoreTrigger {
  SEED
  MANUAL_RECOMPUTE
  AUDIT
}

// ───────────────────── Physical hierarchy ─────────────────────

model Warehouse {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  name   String
  aisles Aisle[]
}

model Aisle {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  code        String // "A"
  position    Int // display order
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  racks       Rack[]

  @@unique([warehouseId, code])
}

model Rack {
  id       Int    @id @default(autoincrement())
  aisleId  Int
  code     String // "01"
  position Int // display order within the aisle
  aisle    Aisle  @relation(fields: [aisleId], references: [id])
  bins     Bin[]

  @@unique([aisleId, code])
}

model Bin {
  id             Int       @id @default(autoincrement())
  rackId         Int
  code           String    @unique // "A-01-03", used for search/scan
  level          Int // heatmap grid row (shelf height)
  position       Int // heatmap grid column
  lastAuditedAt  DateTime? // null = never audited
  currentScoreId Int?      @unique

  rack         Rack          @relation(fields: [rackId], references: [id])
  currentScore BinScore?     @relation("CurrentScore", fields: [currentScoreId], references: [id])
  scoreHistory BinScore[]    @relation("ScoreHistory")
  pallets      Pallet[]
  movements    Movement[]    @relation("MovementBin")
  movesOut     Movement[]    @relation("MovementFromBin")
  tasks        AuditTask[]
  auditResults AuditResult[]

  @@unique([rackId, level, position])
}

// ───────────────────────── Inventory ─────────────────────────

model Product {
  id          Int               @id @default(autoincrement())
  sku         String            @unique
  name        String
  palletItems PalletItem[]
  movements   Movement[]
  auditLines  AuditResultLine[]
}

model Pallet {
  id         Int               @id @default(autoincrement())
  code       String            @unique // license plate, e.g. "PLT-0001"
  binId      Int
  bin        Bin               @relation(fields: [binId], references: [id])
  items      PalletItem[]
  movements  Movement[]
  auditLines AuditResultLine[]
}

// A product line on a pallet: the unit that gets counted (D-003).
model PalletItem {
  id        Int     @id @default(autoincrement())
  palletId  Int
  productId Int
  quantity  Int // current system (expected) quantity
  pallet    Pallet  @relation(fields: [palletId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([palletId, productId])
}

// ───────────────────── Activity history ─────────────────────

model Movement {
  id            Int          @id @default(autoincrement())
  type          MovementType
  binId         Int // affected bin; destination for MOVE/PUTAWAY
  fromBinId     Int? // source bin, MOVE only (counts as activity for both bins, D-012)
  palletId      Int
  productId     Int? // PICK and ADJUSTMENT only
  quantityDelta Int? // PICK: negative; ADJUSTMENT: +/-
  auditResultId Int? // set = adjustment generated by an audit; null = manual
  occurredAt    DateTime

  bin         Bin          @relation("MovementBin", fields: [binId], references: [id])
  fromBin     Bin?         @relation("MovementFromBin", fields: [fromBinId], references: [id])
  pallet      Pallet       @relation(fields: [palletId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  auditResult AuditResult? @relation(fields: [auditResultId], references: [id], onDelete: Restrict)

  @@index([binId, occurredAt])
  @@index([fromBinId, occurredAt])
}

// ───────────────────────── Scoring ─────────────────────────

// Append-only score history (D-014). Rows are never updated;
// Bin.currentScoreId points at the latest one.
model BinScore {
  id            Int          @id @default(autoincrement())
  binId         Int
  score         Int // 0–100
  factors       Json // FactorBreakdown[] from @rivbins/shared
  trigger       ScoreTrigger
  auditResultId Int? // set when trigger = AUDIT
  computedAt    DateTime     @default(now())

  bin         Bin          @relation("ScoreHistory", fields: [binId], references: [id])
  currentFor  Bin?         @relation("CurrentScore")
  auditResult AuditResult? @relation(fields: [auditResultId], references: [id], onDelete: Restrict)

  @@index([binId, computedAt])
}

// ───────────────────────── Audits ─────────────────────────

model AuditPlan {
  id         Int         @id @default(autoincrement())
  requestedN Int
  createdAt  DateTime    @default(now())
  tasks      AuditTask[]
}

model AuditTask {
  id              Int        @id @default(autoincrement())
  planId          Int
  binId           Int
  rank            Int // 1 = riskiest in this plan
  scoreAtCreation Int // snapshot; the bin's score may change later
  status          TaskStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  completedAt     DateTime?

  plan        AuditPlan    @relation(fields: [planId], references: [id])
  bin         Bin          @relation(fields: [binId], references: [id])
  auditResult AuditResult?

  // At most one PENDING task per bin is enforced by a partial unique index
  // ("AuditTask_binId_pending_key") added as raw SQL in the init migration.
  @@index([binId, status])
}

model AuditResult {
  id               Int          @id @default(autoincrement())
  binId            Int
  taskId           Int?         @unique // null = ad-hoc count without a task
  autoOutcome      AuditOutcome
  finalOutcome     AuditOutcome // differs from autoOutcome = user override
  totalExpected    Int
  totalCounted     Int
  discrepancyRatio Float // Σ|counted − expected| / Σ expected
  countedAt        DateTime     @default(now())

  bin         Bin               @relation(fields: [binId], references: [id])
  task        AuditTask?        @relation(fields: [taskId], references: [id])
  lines       AuditResultLine[]
  adjustments Movement[]
  scores      BinScore[]

  @@index([binId, countedAt])
}

model AuditResultLine {
  id            Int @id @default(autoincrement())
  auditResultId Int
  palletId      Int
  productId     Int
  expectedQty   Int // snapshot at count time
  countedQty    Int
  difference    Int // counted − expected

  auditResult AuditResult @relation(fields: [auditResultId], references: [id])
  pallet      Pallet      @relation(fields: [palletId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@index([auditResultId])
}
